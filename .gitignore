# pixi environments
.pixi/*
!.pixi/config.toml

# OS / editor
.DS_Store
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.coverage
htmlcov/

# Environment secrets & user configs
.env
.env.*
ragdoll.toml

# Ragdoll storage & vector databases
.ragdoll/
data/
chroma/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Local input sources staging (ignore contents, preserve scaffolding & manifest)
sources/pdf/*
!sources/pdf/.gitkeep
sources/markdown/*
!sources/markdown/.gitkeep
sources/repos/*
!sources/repos/.gitkeep
!sources/README.md
!sources/manifests/**

# IDE / Editor
.vscode/
.idea/
*.code-workspace

# Sphinx docs build
docs/_build/

# Logs
*.log
casa-*.log

# Notes
notes/
